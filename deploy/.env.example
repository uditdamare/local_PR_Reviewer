# Copy to deploy/.env (git-ignored) and fill in. Used by docker-compose.prod.yml.

# Hostname IT points at this machine, e.g. pr-reviewer.aurumproptech.in
DOMAIN=

# Your GitLab instance (no trailing slash)
GITLAB_URL=https://git.aurumproptech.in

# Database password. Use letters/digits only (it is embedded in a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional
# RATE_LIMIT_MAX=60
# HTTP_PORT=80
# HTTPS_PORT=443
