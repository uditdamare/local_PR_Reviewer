# Copy to deploy/.env (git-ignored) and fill in. Used by docker-compose.prod.yml.

# The public hostname clients connect to, e.g. pr-reviewer.aurumproptech.in.
# The app rejects requests whose Host header differs, so whatever proxy sits in
# front must pass the original Host through. (With --profile caddy this is also
# the name Caddy gets a certificate for.)
DOMAIN=

# Your GitLab instance (no trailing slash)
GITLAB_URL=https://git.aurumproptech.in

# Database password. Use letters/digits only (it is embedded in a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Where the company's HTTPS proxy reaches the app (default setup) ---
# The app port is published on this machine's loopback only. If the proxy runs
# on ANOTHER machine, set MCP_BIND=0.0.0.0 and firewall the port so only that
# proxy can connect (the app speaks plain HTTP).
# MCP_BIND=127.0.0.1
# MCP_PORT=8080

# Reverse-proxy hops in front of the app (company proxy = 1; add one per extra
# proxy/CDN). Needed so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Requests per minute per client IP
# RATE_LIMIT_MAX=60

# --- Only with `--profile caddy` (no company proxy) ---
# HTTP_PORT=80
# HTTPS_PORT=443
