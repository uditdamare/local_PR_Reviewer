    "prisma": "^6.19.3",
    "simple-git": "^3.25.0",
    "typescript": "^5.5.3",
    "uuid": "^9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
