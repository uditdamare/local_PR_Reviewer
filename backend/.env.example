# PORT=3000

GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-your-personal-access-token-here

# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen-coder-smallb


PORT=4000

# LLM provider — any OpenAI-compatible chat-completions endpoint.
# The base URL is used as-is, so it must include whatever path prefix the
# provider requires.
#
# Local Ollama (default):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:0.5b
# LLM_API_KEY=ollama
#
# Gemini (via Google's OpenAI-compatible endpoint — https://ai.google.dev/gemini-api/docs/openai):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=<your-gemini-api-key>
#
# NOTE: switching to a hosted provider sends diffs and full file contents
# over the network to that provider — confirm that's acceptable for the
# repos this reviews before switching off local Ollama.

# Safety limits (V1)
# Max number of files the reviewer will read via read_file per review
MAX_FILES_READ=15
# Max characters of a single file read passed to the LLM context
MAX_FILE_READ_CHARS=20000
# Max characters of the diff passed to the LLM context
MAX_DIFF_CHARS=60000

# GitLab MR review (multi-file batching)
# Max diff characters per LLM call — keep small for small-context-window
# local models so multi-file MRs get batched instead of silently truncated.
REVIEW_BATCH_MAX_DIFF_CHARS=6000
# Max characters of a changed file's full content included as context per
# file, so the model can check "is this actually unused" instead of only
# seeing the bare diff hunk.
REVIEW_RELEVANT_FILE_MAX_CHARS=3000
# Timeout for a single LLM call and for the backend's own HTTP server, in ms.
# Default 30 minutes to accommodate slow/CPU-bound local inference.
LLM_REQUEST_TIMEOUT_MS=1800000
