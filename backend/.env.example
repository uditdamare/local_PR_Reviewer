# PORT=3000

GITLAB_URL=https://gitlab.example.com
# Only needed for the LOCAL stdio MCP server (src/mcp/server.ts, what
# Claude Code/Desktop spawns directly). The remote HTTP server
# (src/mcp/http-server.ts) never reads this — every caller supplies their
# own token via an Authorization header instead. Leave unset entirely when
# only running the HTTP server.
GITLAB_TOKEN=glpat-your-personal-access-token-here

# Postgres (failure-patterns table). Matches docker-compose.yml's default
# credentials for local dev — `docker compose up -d postgres` to start it.
DATABASE_URL=postgresql://pr_reviewer:pr_reviewer_dev_password@localhost:5432/pr_reviewer

# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen-coder-smallb


PORT=4000

# LLM provider — any OpenAI-compatible chat-completions endpoint.
# The base URL is used as-is, so it must include whatever path prefix the
# provider requires.
#
# Local Ollama (default):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:0.5b
# LLM_API_KEY=ollama
#
# Gemini (via Google's OpenAI-compatible endpoint — https://ai.google.dev/gemini-api/docs/openai):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=<your-gemini-api-key>
#
# NOTE: switching to a hosted provider sends diffs and full file contents
# over the network to that provider — confirm that's acceptable for the
# repos this reviews before switching off local Ollama.

# Safety limits (V1)
# Max number of files the reviewer will read via read_file per review
MAX_FILES_READ=15
# Max characters of a single file read passed to the LLM context
MAX_FILE_READ_CHARS=20000
# Max characters of the diff passed to the LLM context
MAX_DIFF_CHARS=60000

# GitLab MR review (multi-file batching)
# Max diff characters per LLM call — keep small for small-context-window
# local models so multi-file MRs get batched instead of silently truncated.
REVIEW_BATCH_MAX_DIFF_CHARS=6000
# Max characters of a changed file's full content included as context per
# file, so the model can check "is this actually unused" instead of only
# seeing the bare diff hunk.
REVIEW_RELEVANT_FILE_MAX_CHARS=3000
# Timeout for a single LLM call and for the backend's own HTTP server, in ms.
# Default 30 minutes to accommodate slow/CPU-bound local inference.
LLM_REQUEST_TIMEOUT_MS=1800000
# Retries on 429/5xx/network errors only (exponential backoff + jitter) —
# a 400/401/404 fails immediately since retrying won't help.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=1000

# Production-risk pattern matching (check_production_risk MCP tool)
# A pattern match below this confidence (0-1) is treated as an abstain
# rather than a reported finding, regardless of what the model claimed.
PRODUCTION_RISK_CONFIDENCE_THRESHOLD=0.6

# Remote HTTP MCP server only (src/mcp/http-server.ts / npm run mcp:http).
# Add with: claude mcp add pr-reviewer --transport http \
#   --header "Authorization: Bearer <your-gitlab-token>" https://<host>/mcp
# HTTP_PORT=8080
# HTTP_HOST=0.0.0.0
# Comma-separated list of hostnames this server is reachable at — without
# this, binding to 0.0.0.0 logs a DNS-rebinding-protection warning on
# startup. Set to your actual deployed hostname once you have one.
# ALLOWED_HOSTS=your-app.up.railway.app
#
# Per-IP rate limit on POST /mcp, applied before the auth check (so
# unauthenticated spam is throttled too). Defaults: 60 requests / 60s.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
# Number of reverse-proxy hops in front of this server (Railway/Render/Fly
# are usually 1). MUST be set when deployed behind a proxy: otherwise every
# request appears to come from the proxy's IP and all users share one bucket.
# TRUST_PROXY=1
#
# On container start the Dockerfile runs `prisma migrate deploy`, then the
# server upserts the curated failure patterns itself before listening — a
# brand-new empty database needs no manual migrate/seed step.
