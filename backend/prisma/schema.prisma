generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FailurePattern {
  id               String   @id
  name             String
  description      String
  exampleSignature String
  sourceName       String
  sourceDate       String
  sourceUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("failure_patterns")
}
